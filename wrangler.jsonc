// Cloudflare Worker config for HHpro (quickselect.hhtrecho.com).
//
// Deploys on every push to master (Workers Builds): the dashboard runs the
// build command `bash build.sh`, which copies only the files the site serves
// into dist/, then `npx wrangler deploy` publishes dist/ plus worker/index.js.
// Nothing outside dist/ (Excel workbooks, engineer schedules, server/) is
// ever uploaded as a site file.
{
  "name": "quick-select-v3",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-14",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Missing files get dist/404.html with a real 404, not the homepage.
    "not_found_handling": "404-page",
    // Only these paths run the Worker; everything else is served straight
    // from the assets (no Worker invocation, no cost).
    "run_worker_first": ["/api/*", "/firms/*", "/ASSETS/*"]
  },

  // Product documentation (submittals, manuals, Revit, CAD) lives in R2, not
  // in Git or dist/. The Worker serves it at /ASSETS/<key> to signed-in users
  // only; the bucket has no public URL. Bucket keys mirror the old local
  // layout, e.g. "MINI SPLITS/SUBMITTALS/<model>.pdf". Created 10/21/2026
  // with `npx wrangler r2 bucket create hhpro-assets`.
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "hhpro-assets"
    }
  ],

  // Cloudflare Access application the site sits behind (one app covers both
  // quickselect.hhtrecho.com and the workers.dev address). Not secrets: the
  // team domain and audience tag are public in every login redirect. Used by
  // server/access.js to verify each request's signed Access token.
  // EMAIL_FROM: sender for Air Handler Design Request emails
  // (server/ahu-requests.js). Must be on a domain onboarded to Cloudflare
  // Email Service (Email Sending) - hhtrecho.com.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "wispy-glitter-fd02.cloudflareaccess.com",
    "ACCESS_AUD": "e7a0ff4c8b88079eed4f34b2763debb74bac4af2b1e638e22b9d146b66ba409e",
    "EMAIL_FROM": "requests@hhtrecho.com"
  },

  // Cloudflare Email Service binding used to email Air Handler Design
  // Requests (recipients: server/ahu-recipients.js). On the Workers Free
  // plan it can only send to addresses verified under Email Service >
  // Email Routing > Destination addresses - each recipient verifies once.
  // If email isn't set up, requests still save and show on Admin > Design
  // Requests with email status "failed" / "not configured".
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],

  // Saved projects (server/projects.js). The tables create themselves on
  // first use. Created 10/20/2026 with `npx wrangler d1 create hhpro-projects`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hhpro-projects",
      "database_id": "5438341a-8a81-4e91-8542-591b067b41c5"
    }
  ],

  "observability": {
    "enabled": true
  },

  // ------------------------------------------------------------------
  // Staging copy of the site (see STAGING.md). Deployed with
  // `npx wrangler deploy --env staging` as the separate Worker
  // "quick-select-v3-staging" at staging.hhtrecho.com - built from the
  // `staging` branch by its own Workers Builds connection. Its own
  // projects database, its own Cloudflare Access app (H&H staff only),
  // no workers.dev / preview URLs. Documents come from the same R2
  // bucket; staging uploads are kept under STAGING/ and staging emails
  // say [STAGING] in the subject. Bindings and vars don't inherit from
  // the top level, so everything the Worker uses is repeated here.
  // ------------------------------------------------------------------
  "env": {
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "staging.hhtrecho.com", "custom_domain": true }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*", "/firms/*", "/ASSETS/*"]
      },
      "r2_buckets": [
        {
          "binding": "DOCS",
          "bucket_name": "hhpro-assets"
        }
      ],
      // ACCESS_AUD: the "Application Audience (AUD) Tag" of the staging
      // Access app. Until it's filled in, nobody can sign in to staging
      // (every identity check fails closed).
      "vars": {
        "ACCESS_TEAM_DOMAIN": "wispy-glitter-fd02.cloudflareaccess.com",
        "ACCESS_AUD": "REPLACE_WITH_STAGING_ACCESS_AUD",
        "EMAIL_FROM": "requests@hhtrecho.com",
        "ENV_LABEL": "STAGING",
        "STORAGE_PREFIX": "STAGING/"
      },
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      // Created 11/03/2026 with `npx wrangler d1 create hhpro-projects-staging`.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hhpro-projects-staging",
          "database_id": "f9d25a7e-96bd-44ab-8a12-765c08338c18"
        }
      ],
      "observability": {
        "enabled": true
      }
    }
  }
}
